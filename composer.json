{
    "name": "kengois/starline-api",
    "description": "PHP-клиент StarLine OpenAPI (SLID-авторизация, состояние и управление устройствами)",
    "type": "library",
        "license": "MIT",
    "authors": [
        {
            "name": "Alexander Tischenko",
            "homepage": "http://alex-tisch.ru"
        }
    ],
    "keywords": ["starline", "starline-api", "slid", "telematics", "car-security"],
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "StarlineApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StarlineApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}