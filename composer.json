{
    "name": "cruide/starline-openapi-php",
    "description": "PHP client for StarLine OpenAPI",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexander Tischenko",
            "homepage": "http://alex-tisch.ru"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Cruide\\StarlineApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cruide\\StarlineApi\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "keywords": [
        "php",
        "starline",
        "starline-api",
        "openapi",
        "client"
    ],
    "authors": [
        {
            "name": "Alexander Tishchenko",
            "homepage": "https://github.com/cruide"
        }
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
